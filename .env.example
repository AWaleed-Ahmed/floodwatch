# FloodWatch configuration
# None of the data APIs below need an account or key. Every endpoint was tested live (HTTP 200) on 2026-11-23.
#
# Backend (Spring Boot) reads this with, in application.properties:
#   spring.config.import=optional:file:../.env[.properties]
# Frontend (Vite) only sees variables that start with VITE_.

# ---------- Open-Meteo (free, non-commercial, ~10,000 calls/day, no key) ----------
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_FLOOD_URL=https://flood-api.open-meteo.com/v1/flood
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_ELEVATION_URL=https://api.open-meteo.com/v1/elevation
OPEN_METEO_TIMEZONE=Asia/Karachi
# Query params used per feature (for reference):
#   forecast : hourly=precipitation,precipitation_probability&forecast_days=7
#   flood    : daily=river_discharge&forecast_days=7   (past data: start_date=YYYY-MM-DD&end_date=YYYY-MM-DD)
#   archive  : daily=precipitation_sum&start_date=...&end_date=...
#   elevation: latitude=a,b,...&longitude=x,y,...   (max 100 points per call)

# ---------- Elevation backups (no key) ----------
OPENTOPODATA_URL=https://api.opentopodata.org/v1/srtm30m
# ~1,000 calls/day, 1 call/second, 100 locations per call
AWS_TERRAIN_TILES_URL=https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png
# PNG height tiles: height_m = (R * 256 + G + B / 256) - 32768

# ---------- Maps (no key; must show "© OpenStreetMap contributors") ----------
VITE_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_OSM_ATTRIBUTION=© OpenStreetMap contributors

# ---------- Official reference (website only, no API) ----------
VITE_PMD_FFD_URL=https://ffd.pmd.gov.pk/

# ---------- App settings (match the Phase 2 design) ----------
FORECAST_CACHE_TTL_MINUTES=30
ALERT_CHECK_INTERVAL_MINUTES=15
ALERT_COOLDOWN_HOURS=6
VITE_ALERT_POLL_SECONDS=60
HTTP_USER_AGENT=FloodWatch-student-prototype

# ---------- Backend URL seen by the frontend ----------
SERVER_PORT=8090
VITE_API_BASE_URL=http://localhost:8090/api

# ---------- Accounts needed later (fill in when created; never commit real values) ----------
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_BUCKET=floodwatch-data
